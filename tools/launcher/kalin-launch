#!/usr/bin/env bash
# kalin-launch — warm-amber fzf launcher for kalin-wm.
#
# One merged fzf list over three sources, each tagged with a leading TYPE field
# and a nerd-font glyph so the dispatch below knows what to do:
#   app   — GUI .desktop entries, launched detached (foot closes)
#   cmd   — $PATH executables, run in this foot via exec (dmenu_run style)
#   tmux  — live tmux sessions (attach) + a "new terminal" entry
#
# Spawned as a plain foot toplevel by the compositor bind
# (`foot --app-id=kalin-launcher -e kalin-launch`), mirroring kalin-clip-picker.
# The PATH it needs (fzf/foot/tmux/util-linux/python3) is prefixed by the
# desktop.nix `kalin-launch` wrapper; this file stays editable in the working
# tree so theme/behaviour tweaks need no rebuild.
set -uo pipefail

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/kalin-launch"
cache="$cache_dir/entries.tsv"
mkdir -p "$cache_dir"

# App/command sources rarely change, so cache them and only rebuild when a
# .desktop directory is newer than the cache (catches installs/removals) or the
# cache is missing. tmux sessions are live and appended fresh each run.
app_dirs=(
	/run/current-system/sw/share/applications
	/etc/profiles/per-user/"$USER"/share/applications
	"$HOME"/.nix-profile/share/applications
	"$HOME"/.local/share/applications
)

cache_stale() {
	[ -f "$cache" ] || return 0
	local d
	for d in "${app_dirs[@]}"; do
		[ -d "$d" ] || continue
		[ "$d" -nt "$cache" ] && return 0
	done
	return 1
}

build_cache() {
	{
		# GUI apps: parse Name/Exec robustly in python (only on a cache miss,
		# so its startup cost is amortised, not paid per launch). Strip the
		# XDG field codes and emit terminal-vs-graphical so dispatch can wrap
		# terminal apps in foot.
		python3 - "${app_dirs[@]}" <<'PY'
import os, sys, glob, re

FIELD = re.compile(r'%[fFuUdDnNickvm]')
seen = set()
for d in sys.argv[1:]:
    for path in sorted(glob.glob(os.path.join(d, "*.desktop"))):
        name = exec_ = None
        terminal = False
        nodisplay = False
        in_entry = False
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    line = line.rstrip("\n")
                    if line.startswith("["):
                        in_entry = line == "[Desktop Entry]"
                        continue
                    if not in_entry:
                        continue
                    if line.startswith("Name=") and name is None:
                        name = line[5:]
                    elif line.startswith("Exec=") and exec_ is None:
                        exec_ = FIELD.sub("", line[5:]).strip()
                    elif line.startswith("Terminal="):
                        terminal = line[9:].strip().lower() == "true"
                    elif line.startswith(("NoDisplay=", "Hidden=")):
                        if line.split("=", 1)[1].strip().lower() == "true":
                            nodisplay = True
        except OSError:
            continue
        if not name or not exec_ or nodisplay:
            continue
        key = name.lower()
        if key in seen:
            continue
        seen.add(key)
        term = "1" if terminal else "0"
        print(f"app\t  {name}\t{exec_}\t{term}")
PY
		# $PATH executables (dmenu_run style). Dedup; skip our own launcher.
		IFS=: read -ra parts <<<"$PATH"
		for p in "${parts[@]}"; do
			[ -d "$p" ] || continue
			for f in "$p"/*; do
				[ -x "$f" ] && [ ! -d "$f" ] || continue
				b="${f##*/}"
				printf 'cmd\t  %s\t%s\n' "$b" "$b"
			done
		done | sort -u -t$'\t' -k3,3
	} >"$cache.tmp" 2>/dev/null && mv "$cache.tmp" "$cache"
}

cache_stale && build_cache

# Live tmux sessions (attach) + a fresh-terminal entry, prepended so they rank
# first. Folds in what kalin-term-pick did.
tmux_entries() {
	printf 'tmuxnew\t󰖍  new terminal\t\n'
	tmux list-sessions -F '#{session_name}	#{session_windows}w#{?session_attached, (attached),}' 2>/dev/null \
		| while IFS=$'\t' read -r sname meta; do
			printf 'tmux\t󰖍  %s  ·  %s\t%s\n' "$sname" "$meta" "$sname"
		done
}

sel="$( { tmux_entries; cat "$cache"; } | fzf \
	--delimiter='\t' --with-nth=2 \
	--reverse --border=rounded --info=inline --cycle \
	--prompt='❯ ' --pointer='▶' --marker='◆' \
	--color='bg+:#3d2c1c,bg:#1e1915,fg:#f0ddc0,fg+:#fff3e0,hl:#f0a030,hl+:#ffb347,pointer:#f0a030,marker:#9aa83f,prompt:#f0a030,info:#6b5642,border:#4a3625,header:#b08d5f,gutter:#1e1915' \
)" || exit 0
[ -n "$sel" ] || exit 0

type="$(printf '%s' "$sel" | cut -f1)"
payload="$(printf '%s' "$sel" | cut -f3)"

case "$type" in
app)
	term="$(printf '%s' "$sel" | cut -f4)"
	if [ "$term" = "1" ]; then
		setsid -f foot -e sh -c "$payload"
	else
		setsid -f sh -c "$payload"
	fi
	;;
cmd)
	# Run in this foot window: exec replaces the launcher, foot lives on until
	# the command exits. GUI-only tools are better picked from the app list.
	# When toggled via tap-Super we live in the kalin-apps tmux window named
	# "launcher" — rename it first, or the next toggle-launcher tap would
	# tmux-kill this still-running command instead of opening a fresh launcher.
	[ -n "${TMUX:-}" ] && tmux rename-window "$payload" 2>/dev/null
	exec sh -c "$payload"
	;;
tmux)
	unset TMUX TMUX_PANE
	exec tmux attach -t "$payload"
	;;
tmuxnew)
	exec kalin-term
	;;
esac
